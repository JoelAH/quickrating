# Firebase Configuration (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# Firebase / Google Analytics web-stream measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Legacy NEXT_PUBLIC_MEASUREMENT_ID is also supported.
# Optional: allow analytics locally and send events to DebugView.
NEXT_PUBLIC_FIREBASE_ANALYTICS_DEBUG=false

# MongoDB Configuration
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Email Service Configuration
EMAIL_API_KEY=your_email_api_key
EMAIL_ALERT_URL=https://your-api-gateway-url.execute-api.region.amazonaws.com/dev/email-alert
NOTIFICATION_EMAIL=your_notification_email@example.com

# Application URLs
DASHBOARD_URL=http://localhost:3000/main/dashboard

# Test Mode (set to true to disable certain features during testing)
TEST_MODE=false

# LemonSqueezy Payment Configuration
LS_API_KEY=your_lemonsqueezy_api_key
LS_STORE_ID=your_store_id
LS_PRODUCT_ID=your_product_id
LS_VARIANT_STANDARD_ID=your_variant_id
LS_WEBHOOK_SIG=your_webhook_signature
LS_REDIRECT_URL=your_payment_redirect_url

# Firebase Admin SDK Configuration (JSON string)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "your_project_id", ...}'

# Trial Pages Configuration (Optional - defaults are used if not set)
# Note: These are hardcoded in the application. To customize, modify the constants in the code.
# TRIAL_PAGE_EXPIRATION_DAYS=14
# TRIAL_PAGE_MAX_REVIEWS=3
# TRIAL_PAGE_RATE_LIMIT_ATTEMPTS=3
# TRIAL_PAGE_RATE_LIMIT_HOURS=24
